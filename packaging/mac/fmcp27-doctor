#!/bin/sh
# Says whether the running Football Manager 27 was started with the FMCP 27 launch line.
set -eu
ROOT="$(cd "$(dirname "$0")" && pwd)"
[ -x "$ROOT/.venv/bin/python" ] || { echo "FMCP 27 is not set up yet. Run: sh \"$ROOT/install.sh\"" >&2; exit 1; }
cd "$ROOT"
exec "$ROOT/.venv/bin/python" "$ROOT/scripts/fm_attach_doctor.py" "$@"
